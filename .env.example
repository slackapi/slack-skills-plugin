# Google Gemini API key(s), required for the LLM-judged eval tests (make test-eval)
# unless EVAL_PROVIDER is antigravity or claude-code. The Gemini eval fails when no key is set. To spread
# requests across the quota, add more keys under any GEMINI_API_KEY* name.
GEMINI_API_KEY=
# GEMINI_API_KEY_BOB=
# GEMINI_API_KEY_MIC=

# Gemini model used as the DeepEval judge. Defaults to gemini-3.1-flash-lite if unset.
GEMINI_MODEL_NAME=gemini-3.1-flash-lite

# Eval model provider: gemini (default, what CI runs), antigravity, or claude-code.
# antigravity and claude-code run that CLI in print mode on your own login, so they need
# no Gemini key and skip the Gemini rate-limit sleep between scenarios.
# EVAL_PROVIDER=claude-code
# Antigravity CLI to run, as a name on your PATH or a full path. Defaults to agy. Disable
# this plugin in it first (agy plugin disable slack), or the eval stops: the CLI can't
# turn plugins off for one run, so the model would also see the installed skills.
# EVAL_ANTIGRAVITY_BIN=agy
# Model passed to the CLI's --model flag (see agy models). Defaults to the CLI's own.
# EVAL_ANTIGRAVITY_MODEL=gemini-3.8-flash-medium
# Claude Code CLI to run, as a name on your PATH or a full path. Defaults to claude.
# EVAL_CLAUDE_BIN=claude
# Model passed to the CLI's --model flag. Defaults to sonnet.
# EVAL_CLAUDE_MODEL=sonnet

# Slack MCP bearer token, required ONLY for the MCP tool-selection test
# (tests/eval/test_tool_selection.py). Leave blank to skip that test.
SLACK_MCP_TOKEN=
